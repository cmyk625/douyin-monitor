    "radix-vue": "^1.9.17",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^26.6.3",
    "@unocss/preset-wind": "^66.10.5",
    "@unocss/reset": "^66.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "commitizen": "^4.3.2",
    "cz-git": "^1.14.0",
    "postcss": "^8.4.49",
